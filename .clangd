Index:
  Background: Build

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  BlockEnd: true

Hover:
  ShowAKA: true

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

CompileFlags:
  CompilationDatabase: embedded/.pio/build
  Add:
    - -ferror-limit=0
    - --target=xtensa
    - -D__XTENSA__=1
  Remove:
    - -mlongcalls
    - -mtext-section-literals
    - -mfix-esp32-psram-cache-issue
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -freorder-blocks
    - -mdisable-hardware-atomics
